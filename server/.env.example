# Copy to .env and fill in values
# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=

# JWT secret used to sign authentication tokens
JWT_SECRET=

# Email SMTP settings (for production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Server port (optional)
# PORT=5000
# Example environment variables for AutoPulse AI server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/autopulse-ai?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# Do NOT store production secrets in this file. Use secure vaults in production.
